# ── AI ────────────────────────────────────────────────
# API key for the AI provider used for scenarios, mentor chat and moderation.
# Required: AI features will not work without this.
AI_API_KEY=

# ── Supabase ──────────────────────────────────────────
# Get these from your Supabase project Settings → API
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only — never expose to the client.
# Required for admin operations.
SUPABASE_SERVICE_ROLE_KEY=

# ── App ───────────────────────────────────────────────
# Your deployed app URL (used for SEO and sitemap).
# Example: https://wisdom-quest.app
VITE_APP_URL=
